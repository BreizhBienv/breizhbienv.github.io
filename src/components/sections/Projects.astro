---
import Button from "../ui/button/Button.astro";
import { projects as projectsFr } from "../../data/projects.fr";
import { projects as projectsEn } from "../../data/projects.en";

import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
}

const { title } = Astro.props as Props;

const projects = lang === 'en' ? projectsEn : projectsFr;
---

<section id="projects" class="w-full py-10">
  <div class="mx-auto max-w-6xl px-4">
    {title && (
      <h2 class="text-3xl md:text-4xl font-semibold text-center mb-8 text-foreground">{title}</h2>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((p, i) => {
        const isLonely = projects.length % 2 === 1 && i === projects.length - 1;
        return (
          <article
            class:list={[
              'card-surface p-6 relative flex flex-col',
              isLonely && 'md:col-span-2 md:w-[calc(50%-0.75rem)] md:justify-self-center',
            ]}
          >
            {p.icon && (
              <div class="absolute right-4 top-4 text-[var(--accent)] [&>svg]:w-6 [&>svg]:h-6" set:html={p.icon} />
            )}
            <h3 class="text-xl font-semibold text-foreground m-0">{p.title}</h3>
            <p class="text-sm text-[color:var(--color-text-muted)] m-0">{p.techStack}</p>
            <p class="mt-3 text-[color:var(--color-text-secondary)]">{p.description}</p>
            <div class="mt-auto pt-6 flex justify-center">
              {p.ctaLink && (
                <Button href={p.ctaLink} variant="primary" size="sm">{p.ctaText}</Button>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>


